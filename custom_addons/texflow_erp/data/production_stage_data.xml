<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="stage_draft" model="texflow.production.stage">
        <field name="name">Draft</field>
        <field name="sequence">10</field>
    </record>

    <record id="stage_confirmed" model="texflow.production.stage">
        <field name="name">Confirmed</field>
        <field name="sequence">20</field>
    </record>

    <record id="stage_in_progress" model="texflow.production.stage">
        <field name="name">In Progress</field>
        <field name="sequence">30</field>
    </record>

    <record id="stage_quality_check" model="texflow.production.stage">
        <field name="name">Quality Check</field>
        <field name="sequence">40</field>
    </record>

    <record id="stage_completed" model="texflow.production.stage">
        <field name="name">Completed</field>
        <field name="sequence">50</field>
    </record>

    <record id="stage_cancelled" model="texflow.production.stage">
        <field name="name">Cancelled</field>
        <field name="sequence">60</field>
        <field name="fold">True</field>
    </record>

</odoo>