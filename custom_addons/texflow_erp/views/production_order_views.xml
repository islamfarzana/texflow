<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Quick Create Form (mirrors Project Task's minimal "Title + Assignees" pattern) -->
    <record id="view_texflow_production_order_quick_create_form" model="ir.ui.view">
        <field name="name">texflow.production.order.quick.create.form</field>
        <field name="model">texflow.production.order</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="product_id" placeholder="e.g. Men's Polo Shirt"/>
                    <field name="assignee_ids" widget="many2many_avatar_user"/>
                </group>
            </form>
        </field>
    </record>

    <!-- Production Order Kanban View (grouped by dynamic Production Stage) -->
    <record id="view_texflow_production_order_kanban" model="ir.ui.view">
        <field name="name">texflow.production.order.kanban</field>
        <field name="model">texflow.production.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id"
                    records_draggable="1"
                    group_create="1"
                    group_edit="1"
                    group_delete="1"
                    quick_create_view="texflow_erp.view_texflow_production_order_quick_create_form">
                <field name="name"/>
                <field name="product_id"/>
                <field name="style"/>
                <field name="fabric"/>
                <field name="color"/>
                <field name="size"/>
                <field name="quantity"/>
                <field name="manufacturing_date"/>
                <field name="quality_status"/>
                <field name="assignee_ids"/>
                <field name="stage_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top d-flex justify-content-between align-items-start">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <field name="quality_status" widget="badge"
                                       decoration-warning="quality_status == 'pending'"
                                       decoration-success="quality_status == 'passed'"
                                       decoration-danger="quality_status == 'failed'"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="text-muted">
                                    <field name="product_id"/>
                                </div>
                                <div t-if="record.style.raw_value or record.color.raw_value or record.size.raw_value"
                                     class="text-muted small">
                                    <t t-if="record.style.raw_value"><field name="style"/></t>
                                    <t t-if="record.color.raw_value">, <field name="color"/></t>
                                    <t t-if="record.size.raw_value">, <field name="size"/></t>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom d-flex justify-content-between align-items-center mt-2">
                                <div class="oe_kanban_bottom_left text-muted">
                                    <i class="fa fa-cubes me-1" title="Quantity"/>
                                    <field name="quantity"/>
                                    <i class="fa fa-calendar ms-3 me-1" title="Manufacturing Date"/>
                                    <field name="manufacturing_date"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="assignee_ids" widget="many2many_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Production Order List View -->
    <record id="view_texflow_production_order_list" model="ir.ui.view">
        <field name="name">texflow.production.order.list</field>
        <field name="model">texflow.production.order</field>
        <field name="arch" type="xml">
            <list string="Production Orders" decoration-danger="quality_status == 'failed'">
                <field name="name"/>
                <field name="product_id"/>
                <field name="style"/>
                <field name="fabric"/>
                <field name="color"/>
                <field name="size"/>
                <field name="quantity"/>
                <field name="manufacturing_date"/>
                <field name="assignee_ids" widget="many2many_avatar_user"/>
                <field name="stage_id"/>
                <field name="quality_status"/>
            </list>
        </field>
    </record>

    <!-- Production Order Form View -->
    <record id="view_texflow_production_order_form" model="ir.ui.view">
        <field name="name">texflow.production.order.form</field>
        <field name="model">texflow.production.order</field>
        <field name="arch" type="xml">
            <form string="Production Order">

                <header>
                    <field name="stage_id" widget="statusbar"
                           options="{'clickable': '1', 'fold_field': 'fold'}"/>
                </header>

                <sheet>

                    <div class="alert alert-danger" role="alert"
                         invisible="quality_status != 'failed'">
                        <strong>Quality Check Failed</strong> — this order did not
                        pass quality inspection. Review before proceeding.
                    </div>

                    <div class="oe_title">
                        <label for="name" string="Production Order"/>
                        <h1>
                            <field name="name" placeholder="e.g. PO00001 (auto-generated)"/>
                        </h1>
                    </div>

                    <group>

                        <group string="Product Information">
                            <field name="product_id" placeholder="e.g. Men's Polo Shirt"/>
                            <field name="style" placeholder="e.g. STY-2026-014"/>
                            <field name="fabric" placeholder="e.g. 100% Cotton Pique"/>
                            <field name="color" placeholder="e.g. Navy Blue"/>
                            <field name="size" placeholder="e.g. XL"/>
                        </group>

                        <group string="Production Information">
                            <field name="quantity" placeholder="e.g. 500"/>
                            <field name="manufacturing_date"/>
                            <field name="quality_status"/>
                            <field name="assignee_ids" widget="many2many_avatar_user"/>
                        </group>

                    </group>

                </sheet>

            </form>
        </field>
    </record>

    <!-- Production Order Window Action -->
    <record id="action_texflow_production_order" model="ir.actions.act_window">
        <field name="name">Production Orders</field>
        <field name="res_model">texflow.production.order</field>
        <field name="view_mode">kanban,list,form,graph,pivot</field>
        <field name="search_view_id" ref="view_texflow_production_order_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Production Order
            </p>
        </field>
    </record>

    <!-- Reporting Action: opens directly into Graph/Pivot analysis -->
    <record id="action_texflow_production_order_reporting" model="ir.actions.act_window">
        <field name="name">Production Reporting</field>
        <field name="res_model">texflow.production.order</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="search_view_id" ref="view_texflow_production_order_search"/>
        <field name="context">{'search_default_group_stage': 1}</field>
    </record>

</odoo>