<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="action_texflow_production_order" model="ir.actions.act_window">

        <field name="name">Production Orders</field>
        <field name="res_model">texflow.production.order</field>
        <field name="view_mode">kanban,list,form</field>

    </record>


    <record id="action_texflow_production_stage" model="ir.actions.act_window">

        <field name="name">Production Stages</field>
        <field name="res_model">texflow.production.stage</field>
        <field name="view_mode">list,form</field>

    </record>


    <menuitem
        id="menu_texflow_root"
        name="TexFlow ERP"
        sequence="10"
    />


    <menuitem
        id="menu_texflow_manufacturing"
        name="Manufacturing"
        parent="menu_texflow_root"
        sequence="10"
    />


    <menuitem
        id="menu_texflow_production_orders"
        name="Production Orders"
        parent="menu_texflow_manufacturing"
        action="action_texflow_production_order"
        sequence="10"
    />


    <menuitem
        id="menu_texflow_configuration"
        name="Configuration"
        parent="menu_texflow_root"
        sequence="90"
    />


    <menuitem
        id="menu_texflow_production_stages"
        name="Production Stages"
        parent="menu_texflow_configuration"
        action="action_texflow_production_stage"
        sequence="10"
    />

</odoo>